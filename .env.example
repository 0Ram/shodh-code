# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://shodh:shodh_password@localhost:5432/shodh_db?schema=public

# JWT Security
JWT_SECRET=shodh-super-secure-production-jwt-secret-key-2026
JWT_EXPIRATION=86400s

# Worker Configuration
WORKER_POLL_INTERVAL_MS=500
WORKER_BATCH_SIZE=5
WORKER_LEASE_DURATION_SEC=30
WORKER_MAX_RETRIES=3

# Runner Mode: "docker" or "subprocess"
RUNNER_MODE=subprocess
RUNNER_DOCKER_IMAGE=shodh-runner:latest
RUNNER_TIMEOUT_MS=5000
RUNNER_MEMORY_LIMIT_MB=128
RUNNER_OUTPUT_LIMIT_BYTES=65536
